# Supabase — client will supply these separately (Session 1 does not connect a live DB).
# Copy to .env.local and fill in when wiring the real database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key used by the iCal sync job (later session). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
